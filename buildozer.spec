[app]
title = Princess Snake
package.name = princesssnake
package.domain = org.kobbyceo
source.dir = .
source.include_exts = py,wav,png,jpg,kv
version = 1.0
requirements = python3,kivy
orientation = portrait
fullscreen = 1
android.api = 35
android.minapi = 24
android.archs = arm64-v8a, armeabi-v7a
android.accept_sdk_license = True
p4a.bootstrap = sdl2

[buildozer]
log_level = 2
warn_on_root = 1
